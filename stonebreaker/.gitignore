# Godot 4 .gitignore

# Godot-specific
.godot/
*.uid

# Exported projects
export/
*.exe
*.x86_64
*.x86_32
*.arm64
*.dmg
*.app
*.apk
*.aab
*.wasm
*.pck
*.zip

# Import cache (regenerated by editor)
.import/

# macOS
.DS_Store

# Windows
Thumbs.db

# JetBrains IDEs
.idea/

# VS Code
.vscode/

# GUT (test runner) output
tests/results/

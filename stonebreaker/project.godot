; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but the properties are documented here for scripting.
;
; Format:
;    [section] ; section goes between []
;    param=value ; assign values to parameters

config_version=5

[application]

config/name="StoneBreaker"
config/description="A 2D Sonic-style terrakinetic platformer starring Rocky."
config/version="0.1.0"
config/tags=PackedStringArray("2d", "action", "platformer")
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"
run/main_scene=""
run/max_fps=60

[autoload]

EventBus="*res://systems/event_bus.gd"
GameState="*res://systems/game_state.gd"
InputBuffer="*res://systems/input_buffer.gd"
AudioBus="*res://systems/audio_bus.gd"
SceneRouter="*res://systems/scene_router.gd"
SaveManager="*res://systems/save_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"

